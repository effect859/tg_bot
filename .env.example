# Токен бота от @BotFather
BOT_TOKEN=123456789:replace-me

# PostgreSQL (значения совпадают с docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://tg_bot:tg_bot@localhost:5432/tg_bot
# Отдельная БД для тестов: создаётся docker/postgres/init.sql, тесты пересоздают в ней схему
TEST_DATABASE_URL=postgresql+asyncpg://tg_bot:tg_bot@localhost:5432/tg_bot_test
DB_ECHO=false

# Redis: хранилище FSM-состояний диалогов
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

# Каталог локального файлового хранилища (входные задания, готовые документы)
STORAGE_DIR=var/storage

# Лимит памяти (RLIMIT_AS) дочернего процесса извлечения текста, МиБ. Только Linux;
# 0 — без лимита. Экспериментальное значение.
EXTRACTION_MEMORY_LIMIT_MIB=1024

# Anthropic API: анализ материалов заказа. Без ключа бот не запускается
# (миграциям и тестам ключ не нужен; в тестах используется подменный клиент).
ANTHROPIC_API_KEY=
# Модель для анализа материалов
LLM_MODEL=claude-sonnet-5-5

# Heartbeat: метка живости процесса бота для Docker HEALTHCHECK (python -m app.healthcheck).
# Бот обновляет метку после успешного SELECT 1 раз в HEARTBEAT_INTERVAL_SECONDS;
# метка старше HEARTBEAT_MAX_AGE_SECONDS (не меньше интервала) — контейнер нездоров.
HEARTBEAT_PATH=var/heartbeat
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_MAX_AGE_SECONDS=120

# Production (docker-compose.prod.yml): DATABASE_URL и REDIS_URL собираются compose-файлом;
# задайте POSTGRES_PASSWORD (обязательно) и при необходимости POSTGRES_USER, POSTGRES_DB.
# POSTGRES_PASSWORD=
