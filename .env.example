# Токен бота от @BotFather
BOT_TOKEN=123456789:replace-me

# PostgreSQL (значения совпадают с docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://tg_bot:tg_bot@localhost:5432/tg_bot
# Отдельная БД для тестов: создаётся docker/postgres/init.sql, тесты пересоздают в ней схему
TEST_DATABASE_URL=postgresql+asyncpg://tg_bot:tg_bot@localhost:5432/tg_bot_test
DB_ECHO=false

# Redis: хранилище FSM-состояний диалогов
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

# Каталог локального файлового хранилища (входные задания, готовые документы)
STORAGE_DIR=var/storage

# Лимит памяти (RLIMIT_AS) дочернего процесса извлечения текста, МиБ. Только Linux;
# 0 — без лимита. Экспериментальное значение.
EXTRACTION_MEMORY_LIMIT_MIB=1024
